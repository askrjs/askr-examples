{
  "name": "@askrjs/example-ssr-only",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 3001",
    "start": "node serve.mjs",
    "build": "vp build --configLoader native && vp build --ssr src/server/production.ts --outDir dist/server --configLoader native",
    "preview": "vp preview --host 127.0.0.1 --port 4001",
    "fmt": "vp fmt .",
    "lint": "vp lint .",
    "test": "vp test run",
    "typecheck": "tsc --noEmit --pretty false",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@askrjs/askr": ">=0.0.88 <0.1.0",
    "@askrjs/lucide": ">=0.0.8 <0.1.0",
    "@askrjs/node": ">=0.0.8 <0.1.0",
    "@askrjs/server": ">=0.0.11 <0.1.0",
    "@askrjs/themes": ">=0.0.23 <0.1.0",
    "@askrjs/ui": ">=0.0.26 <0.1.0"
  },
  "devDependencies": {
    "@askrjs/vite": ">=0.0.12 <0.1.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plus": "^0.2.8",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1"
}
