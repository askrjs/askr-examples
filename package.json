{
  "name": "askr-examples",
  "version": "0.0.1",
  "private": true,
  "description": "Runnable examples for the Askr platform",
  "license": "Apache-2.0",
  "workspaces": [
    "spa",
    "ssr-only",
    "api-ssr",
    "api-only",
    "ssg",
    "mcp-server"
  ],
  "type": "module",
  "scripts": {
    "fmt": "npm run fmt --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "openapi": "npm run openapi --workspaces --if-present",
    "openapi:check": "npm run openapi:check --workspaces --if-present",
    "test:journey": "vp test run -c vitest.config.ts",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:journey && npm run openapi:check",
    "acceptance": "npm run check && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@askrjs/askr": ">=0.2.0 <0.3.0",
    "@askrjs/schema": ">=0.2.0 <0.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "monaco-editor": "^0.56.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.8",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "3.4.13"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1"
}
