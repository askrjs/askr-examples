{
  "name": "askr-examples",
  "private": true,
  "version": "0.0.1",
  "description": "Runnable examples for the Askr platform",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["spa", "ssr-only", "api-ssr", "api-only", "ssg", "mcp-server"],
  "scripts": {
    "fmt": "npm run fmt --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "openapi": "npm run openapi --workspaces --if-present",
    "openapi:check": "npm run openapi:check --workspaces --if-present",
    "test:journey": "vp test run -c vitest.config.ts",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:journey && npm run openapi:check",
    "acceptance": "npm run check && npm run build && npm run test:browser"
  },
  "overrides": {
    "dompurify": "3.4.12"
  },
  "devDependencies": {
    "@askrjs/schema": ">=0.0.5 <0.1.0",
    "@types/node": "^26.1.2",
    "@playwright/test": "^1.62.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.8",
    "vitest": "^4.1.10"
  },
  "engines": { "node": ">=24.0.0" },
  "packageManager": "npm@12.0.1"
}
