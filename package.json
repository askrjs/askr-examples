{
  "name": "askr-examples",
  "version": "0.0.1",
  "private": true,
  "description": "Runnable examples for the Askr platform",
  "license": "Apache-2.0",
  "workspaces": [
    "spa",
    "ssr-only",
    "api-ssr",
    "api-only",
    "ssg",
    "mcp-server",
    "provider-auth"
  ],
  "type": "module",
  "scripts": {
    "fmt": "npm run fmt --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "openapi": "npm run openapi --workspaces --if-present",
    "openapi:check": "npm run openapi:check --workspaces --if-present",
    "test:journey": "vp test run -c vitest.config.ts",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run lint:qualification && npm run test:qualification && npm run typecheck && npm test && npm run test:journey && npm run openapi:check && npm run test:provider-installed",
    "acceptance": "npm run check && npm run build && npm run test:runtime && npm run test:browser && npm run test:provider-types && npm run test:provider-browser",
    "lint:qualification": "vp lint scripts/qualification tests/qualification playwright.config.ts playwright",
    "test:qualification": "node --test tests/qualification/*.test.mjs",
    "test:runtime": "node scripts/qualification/workspace-runtime.mjs",
    "test:stages": "node scripts/qualification/independent-stages.mjs --source .",
    "test:provider-browser": "npm run test:browser --workspace @askrjs/example-provider-auth",
    "test:provider-types": "npm run test:types6 --workspace @askrjs/example-provider-auth && npm run test:types7 --workspace @askrjs/example-provider-auth",
    "test:provider-installed": "npm run test:installed --workspace @askrjs/example-provider-auth"
  },
  "devDependencies": {
    "@askrjs/askr": ">=0.5.0 <0.6.0",
    "@askrjs/schema": ">=0.5.0 <0.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "jsdom": "^30.0.1",
    "monaco-editor": "^0.56.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1"
}
