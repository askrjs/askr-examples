{
  "name": "@askrjs/example-api-ssr",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 3002",
    "start": "node serve.mjs",
    "build": "vp build --configLoader native && vp build --ssr src/server/production.ts --outDir dist/server --configLoader native",
    "preview": "vp preview --host 127.0.0.1 --port 4002",
    "fmt": "vp fmt . --ignore-path .oxfmtignore",
    "lint": "vp lint .",
    "test": "vp test run",
    "typecheck": "tsc --noEmit --pretty false",
    "openapi": "askr openapi",
    "openapi:check": "askr openapi --check",
    "check": "npm run lint && npm run typecheck && npm test && npm run openapi:check"
  },
  "dependencies": {
    "@askrjs/askr": ">=0.2.3 <0.3.0",
    "@askrjs/auth": ">=0.2.1 <0.3.0",
    "@askrjs/charts": ">=0.2.0 <0.3.0",
    "@askrjs/i18n": ">=0.2.0 <0.3.0",
    "@askrjs/lucide": ">=0.2.1 <0.3.0",
    "@askrjs/monaco": ">=0.2.1 <0.3.0",
    "@askrjs/node": ">=0.2.1 <0.3.0",
    "@askrjs/otel": ">=0.2.1 <0.3.0",
    "@askrjs/schema": ">=0.2.1 <0.3.0",
    "@askrjs/server": ">=0.2.1 <0.3.0",
    "@askrjs/themes": ">=0.2.4 <0.3.0",
    "@askrjs/ui": ">=0.2.3 <0.3.0",
    "@opentelemetry/api": "^1.9.1",
    "monaco-editor": "^0.56.0"
  },
  "devDependencies": {
    "@askrjs/cli": ">=0.2.1 <0.3.0",
    "@askrjs/vite": ">=0.2.1 <0.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plus": "^0.2.8",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1"
}
