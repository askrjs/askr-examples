{
  "name": "@askrjs/example-ssg",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 3003",
    "start": "node serve.mjs",
    "build": "npm run build:client && npm run generate",
    "build:client": "vp build --configLoader native",
    "generate": "askr ssg --config ./ssg.config.ts --output ./dist/static",
    "generate:incremental": "npm run generate -- --incremental",
    "fmt": "vp fmt .",
    "lint": "vp lint .",
    "test": "vp test run",
    "typecheck": "tsc --noEmit --pretty false",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@askrjs/askr": ">=0.2.3 <0.3.0",
    "@askrjs/lucide": ">=0.2.1 <0.3.0",
    "@askrjs/themes": ">=0.2.4 <0.3.0",
    "@askrjs/ui": ">=0.2.3 <0.3.0"
  },
  "devDependencies": {
    "@askrjs/cli": ">=0.2.1 <0.3.0",
    "@askrjs/vite": ">=0.2.1 <0.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plus": "^0.2.8",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1"
}
