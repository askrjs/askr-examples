{
  "name": "@askrjs/example-api-only",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json --pretty false",
    "fmt": "vp fmt . --ignore-path .oxfmtignore",
    "lint": "vp lint .",
    "test": "vp test run",
    "typecheck": "tsc --noEmit --pretty false",
    "openapi": "askr openapi",
    "openapi:check": "askr openapi --check",
    "check": "npm run lint && npm run typecheck && npm test && npm run openapi:check"
  },
  "dependencies": {
    "@askrjs/auth": ">=0.5.0 <0.6.0",
    "@askrjs/node": ">=0.5.0 <0.6.0",
    "@askrjs/schema": ">=0.5.0 <0.6.0",
    "@askrjs/server": ">=0.5.0 <0.6.0"
  },
  "devDependencies": {
    "@askrjs/cli": ">=0.5.0 <0.6.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1"
}
